<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_countdown_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6352941"
        android:background="@drawable/widget_countdown_panel"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_countdown_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="21.333dp"
        android:paddingEnd="8.533dp">

        <ImageView
            android:id="@+id/widget_countdown_icon"
            android:layout_width="54.2dp"
            android:layout_height="52.8dp"
            android:importantForAccessibility="no"
            android:paddingEnd="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/widget_countdown_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="sec"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_state_loading"
                android:textColor="#A6FCFCFF"
                android:textFontWeight="500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_countdown_timer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="sec"
                android:fontFeatureSettings="tnum"
                android:gravity="start|top"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FCFCFF"
                android:textFontWeight="500"
                android:textSize="23.5sp"
                android:visibility="gone" />

            <include layout="@layout/prayer_widget_state" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_countdown_settings"
            android:layout_width="78.8dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/widget_countdown_progress"
                android:layout_width="60.8dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:importantForAccessibility="no"
                android:paddingStart="8dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_countdown_gear"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="4.5dp"
                android:background="@drawable/widget_countdown_gear_background"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_countdown_settings" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
