<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_countdown_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_countdown_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="21.333dp"
        android:paddingEnd="8.533dp">

        <ImageView
            android:id="@+id/widget_countdown_icon"
            android:layout_width="54.2dp"
            android:layout_height="52.8dp"
            android:importantForAccessibility="no"
            android:paddingEnd="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/widget_countdown_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="sec"
                android:gravity="start|top"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_countdown_setup"
                android:textColor="#A6FCFCFF"
                android:textFontWeight="500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_countdown_timer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="sec"
                android:fontFeatureSettings="tnum"
                android:gravity="start|top"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FCFCFF"
                android:textFontWeight="500"
                android:textSize="23.5sp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_countdown_progress"
            android:layout_width="60.8dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:paddingStart="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
