<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_countdown_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/widget_countdown_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_countdown_back"
            android:scaleType="center"
            android:src="@drawable/ic_countdown_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_countdown_settings"
            android:textAppearance="@android:style/TextAppearance.Material.Title"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/widget_countdown_settings_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?android:attr/colorBackground"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/widget_countdown_preview"
                android:layout_width="match_parent"
                android:layout_height="144dp"
                android:background="@drawable/widget_panel"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/countdown_settings_horizon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/countdown_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_countdown_appearance"
                    android:textAppearance="@android:style/TextAppearance.Material.Body1"
                    android:textColor="?android:attr/textColorSecondary" />

                <RadioGroup
                    android:id="@+id/widget_countdown_theme_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:saveEnabled="false">

                    <RadioButton
                        android:id="@+id/widget_countdown_theme_system"
                        style="@style/CountdownRadioOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/widget_countdown_theme_system" />

                    <RadioButton
                        android:id="@+id/widget_countdown_theme_light"
                        style="@style/CountdownRadioOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/widget_countdown_theme_light" />

                    <RadioButton
                        android:id="@+id/widget_countdown_theme_dark"
                        style="@style/CountdownRadioOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/widget_countdown_theme_dark" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@+id/widget_countdown_transparency"
                        android:text="@string/widget_countdown_transparency"
                        android:textAppearance="@android:style/TextAppearance.Material.Body1"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/widget_countdown_transparency_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textAppearance="@android:style/TextAppearance.Material.Body1"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <SeekBar
                    android:id="@id/widget_countdown_transparency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:max="100"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:saveEnabled="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_countdown_ring_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/countdown_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_countdown_ring"
                    android:textAppearance="@android:style/TextAppearance.Material.Body1"
                    android:textColor="?android:attr/textColorSecondary" />

                <RadioGroup
                    android:id="@+id/widget_countdown_ring_modes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:saveEnabled="false">

                    <RadioButton
                        android:id="@+id/widget_countdown_ring_solid"
                        style="@style/CountdownRadioOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/widget_countdown_ring_solid" />

                    <RadioGroup
                        android:id="@+id/widget_countdown_ring_color_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal"
                        android:saveEnabled="false"
                        android:visibility="gone" />

                    <RadioButton
                        android:id="@+id/widget_countdown_ring_time_based"
                        style="@style/CountdownRadioOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/widget_countdown_ring_time_based" />

                    <LinearLayout
                        android:id="@+id/widget_countdown_ring_time_samples"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_countdown_display_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/countdown_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_countdown_display"
                    android:textAppearance="@android:style/TextAppearance.Material.Body1"
                    android:textColor="?android:attr/textColorSecondary" />

                <Switch
                    android:id="@+id/widget_countdown_show_prayer_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:text="@string/widget_countdown_show_prayer_time"
                    android:textColor="@color/countdown_option_text" />

                <TextView
                    android:id="@+id/widget_countdown_display_size_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="@string/widget_countdown_display_size_note"
                    android:textAppearance="@android:style/TextAppearance.Material.Caption"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

                <Switch
                    android:id="@+id/widget_timetable_highlight_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:text="@string/widget_timetable_highlight_next"
                    android:textColor="@color/countdown_option_text"
                    android:visibility="gone" />

                <Switch
                    android:id="@+id/widget_timetable_show_app_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:text="@string/widget_timetable_show_app_logo"
                    android:textColor="@color/countdown_option_text"
                    android:visibility="gone" />

                <Switch
                    android:id="@+id/widget_countdown_show_prayer_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:text="@string/widget_countdown_show_prayer_icon"
                    android:textColor="@color/countdown_option_text" />

                <TextView
                    android:id="@+id/widget_timetable_pictures_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="@string/widget_timetable_pictures_info"
                    android:textAppearance="@android:style/TextAppearance.Material.Caption"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

                <Switch
                    android:id="@+id/widget_timetable_include_night_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:text="@string/widget_timetable_include_night_times"
                    android:textColor="@color/countdown_option_text"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_timetable_night_times_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="@string/widget_timetable_night_times_info"
                    android:textAppearance="@android:style/TextAppearance.Material.Caption"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
